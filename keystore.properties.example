# Copy to keystore.properties (git-ignored) to have Gradle sign release builds.
# Paths are relative to this folder. Alternatively set FLARE_KEYSTORE, FLARE_KEYSTORE_PASSWORD,
# FLARE_KEY_ALIAS, FLARE_KEY_PASSWORD (and FLARE_KEYSTORE_TYPE) in the environment.
# Without either, ./gradlew assembleRelease produces an unsigned APK.
storeFile=../release-key.p12
storeType=pkcs12
storePassword=change-me
keyAlias=flare
keyPassword=change-me
